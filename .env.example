# ==============================================================================
# VulnTrack Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local Docker Compose runs.
# IMPORTANT: NEVER commit real passwords or secret keys to version control.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=vulntrack
POSTGRES_USER=vulntrack_user
POSTGRES_PASSWORD=vulntrack_dev_secret_change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend Spring Boot Configuration
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Demo Credentials (BCrypt hashed in code, defined here for testing)
# Admin role has read/write privileges (Asset and Vulnerability creation/modification)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=AdminSecurePassword!2026

# Viewer role has read-only privileges (GET requests only)
APP_VIEWER_USERNAME=viewer
APP_VIEWER_PASSWORD=ViewerReadOnlyPassword!2026

# Application Security
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api

# Container Registry & Image Tag (Used in CI/CD)
IMAGE_REGISTRY=ghcr.io
IMAGE_NAME=vulntrack-backend
IMAGE_TAG=latest
